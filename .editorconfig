# https://editorconfig.org/
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{php,css,js,html}]
indent_style = tab
tab_width = 4
max_line_length = 200

[*.js]
max_line_length = 150

[*.json]
indent_style = space
indent_size = 4

[*.md]
indent_style = space
max_line_length = off

[admin/translations/*.php]
max_line_length = off
